# Horizon SPOG - Environment Variables
# Copy this file to .env and update values as needed.

# Application title displayed in the UI
VITE_APP_TITLE=Horizon SPOG

# Default persona for the dashboard view (e.g., executive, engineering, operations)
VITE_DEFAULT_PERSONA=executive

# API base URL (if connecting to a backend service)
# VITE_API_BASE_URL=http://localhost:3000/api

# Feature flags
# VITE_ENABLE_DARK_MODE=true
# VITE_ENABLE_EXPORT=true